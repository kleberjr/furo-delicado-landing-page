---
import Icone from "./Icone.astro";
import TituloSecao from "./TituloSecao.astro";
import type { Site } from "../content/site";

interface Props {
  diferenciais: Site["diferenciais"];
}

const { diferenciais } = Astro.props;
---

<section class="section" aria-labelledby="diferenciais-titulo">
  <div class="container">
    <TituloSecao
      id="diferenciais-titulo"
      eyebrow={diferenciais.eyebrow}
      titulo={diferenciais.titulo}
      centro
    />
    <ul class="diferenciais" role="list">
      {diferenciais.itens.map((d) => (
        <li class:list={["diferencial", `pastel--${d.cor}`]}>
          <span class="diferencial__icone">
            <Icone nome={d.icone} class="diferencial__svg" />
          </span>
          <h3>{d.titulo}</h3>
          <p>{d.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .diferenciais {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
  }

  .diferencial {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
  }

  .diferencial__icone {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--color-card);
    color: var(--color-rose-strong);
  }

  .diferencial__icone :global(.diferencial__svg) {
    width: 1.375rem;
  }

  .diferencial h3 {
    margin-bottom: var(--space-2);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
  }

  .diferencial p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  @media (width >= 40rem) {
    .diferenciais {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width >= 64rem) {
    .diferenciais {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
