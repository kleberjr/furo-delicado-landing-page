---
import type { Site } from "../content/site";

interface Props {
  rodape: Site["rodape"];
  empresa: Site["empresa"];
  nome: string;
}

const { rodape, empresa, nome } = Astro.props;
---

<footer class="rodape section--escuro">
  <div class="container rodape__base">
    <p>
      © {new Date().getFullYear()} {nome} · {empresa.titular}
      {empresa.cnpj && <> · CNPJ {empresa.cnpj}</>}
    </p>
    <a href="/politica-de-privacidade/">{rodape.privacidade}</a>
  </div>
</footer>

<style>
  /* No celular, o texto centralizado fica acima do botão flutuante do WhatsApp. */
  .rodape {
    padding-block: var(--space-6) calc(var(--space-16) + var(--space-4));
  }

  @media (width >= 48rem) {
    .rodape {
      padding-block: var(--space-6);
    }
  }

  .rodape__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    font-size: var(--font-size-xs);
    color: var(--color-on-plum-muted);
  }

  .rodape__base p {
    margin: 0;
    text-align: center;
  }

  .rodape__base a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-block: calc(var(--space-3) * -1);
  }
</style>
