---
import { Image } from "astro:assets";
import Icone from "./Icone.astro";
import { formatarTelefoneBR, telHref, whatsappUrl } from "../lib/contato";
import { imagem } from "../lib/imagens";
import type { Site } from "../content/site";

interface Props {
  rodape: Site["rodape"];
  contato: Site["contato"];
  empresa: Site["empresa"];
  nome: string;
}

const { rodape, contato, empresa, nome } = Astro.props;
---

<footer class="rodape section--escuro">
  <div class="container">
    <div class="rodape__grade">
      <div class="rodape__marca">
        <a href="/" class="rodape__logo">
          <Image
            src={imagem(rodape.logo.arquivo)}
            alt={rodape.logo.alt}
            widths={[180, 360]}
            sizes="10rem"
          />
        </a>
        <p>{rodape.frase}</p>
        <a
          class="rodape__link"
          href={contato.instagram.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icone nome="instagram" class="rodape__icone" />
          {contato.instagram.usuario}
        </a>
      </div>

      <div>
        <h2>{rodape.contatoTitulo}</h2>
        <a
          class="rodape__link"
          href={whatsappUrl(contato.whatsapp, contato.mensagemWhatsapp)}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icone nome="whatsapp" class="rodape__icone" />
          WhatsApp {formatarTelefoneBR(contato.whatsapp)}
        </a>
        {contato.telefone && (
          <a class="rodape__link" href={telHref(contato.telefone)}>
            <Icone nome="telefone" class="rodape__icone" />
            {formatarTelefoneBR(contato.telefone)}
          </a>
        )}
      </div>

      <div>
        <h2>{rodape.enderecoTitulo}</h2>
        <a class="rodape__link" href={contato.mapaUrl} target="_blank" rel="noopener noreferrer">
          <Icone nome="local" class="rodape__icone" />
          <span>
            {contato.enderecoLinhas.rua}
            <br />
            {contato.enderecoLinhas.cidade}
          </span>
        </a>
      </div>

      <div>
        <h2>{rodape.horarioTitulo}</h2>
        <p class="rodape__item">
          <Icone nome="relogio" class="rodape__icone" />
          <span>
            {contato.horario.join(" · ")}
            <br />
            {contato.atendimento}
          </span>
        </p>
      </div>
    </div>

    <div class="rodape__base">
      <p>
        © {new Date().getFullYear()} {nome} · {empresa.titular}
        {empresa.cnpj && <> · CNPJ {empresa.cnpj}</>}
      </p>
      <a href="/politica-de-privacidade/">{rodape.privacidade}</a>
    </div>
  </div>
</footer>

<style>
  /* Fundo extra: o botão flutuante do WhatsApp não cobre a última linha. */
  .rodape {
    padding-block: var(--space-16) calc(var(--space-16) + var(--space-8));
    font-size: var(--font-size-sm);
  }

  .rodape__grade {
    display: grid;
    gap: var(--space-10);
  }

  .rodape__logo {
    display: inline-block;
    margin-bottom: var(--space-4);
  }

  .rodape__logo :global(img) {
    width: 9rem;
  }

  .rodape__marca p {
    max-width: 18rem;
    color: var(--color-on-plum-muted);
  }

  .rodape h2 {
    margin-bottom: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-eyebrow);
    text-transform: uppercase;
    color: var(--color-blush);
  }

  .rodape__link,
  .rodape__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: var(--tap-min);
    margin: 0;
    padding-block: var(--space-2);
    color: var(--color-on-plum);
    text-decoration: none;
  }

  .rodape__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .rodape :global(.rodape__icone) {
    width: 1.125rem;
    flex: none;
    margin-top: 0.2em;
    color: var(--color-rose-soft);
  }

  .rodape__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-plum-line);
    font-size: var(--font-size-xs);
    color: var(--color-on-plum-muted);
  }

  .rodape__base p {
    margin: 0;
  }

  .rodape__base a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-block: calc(var(--space-3) * -1);
  }

  @media (width >= 48rem) {
    .rodape__grade {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width >= 64rem) {
    .rodape__grade {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }
</style>
