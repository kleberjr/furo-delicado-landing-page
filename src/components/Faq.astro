---
import TituloSecao from "./TituloSecao.astro";
import type { Site } from "../content/site";

interface Props {
  faq: Site["faq"];
}

const { faq } = Astro.props;
---

<section class="section section--alt" aria-labelledby="faq-titulo">
  <div class="container faq">
    <TituloSecao id="faq-titulo" eyebrow={faq.eyebrow} titulo={faq.titulo} />
    <div class="faq__lista">
      {faq.perguntas.map((p) => (
        <details>
          <summary>
            {p.pergunta}
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <p>{p.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: var(--space-10);
  }

  .faq__lista {
    border-top: 1px solid var(--color-arch-line);
  }

  details {
    border-bottom: 1px solid var(--color-arch-line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--tap-min);
    padding-block: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  summary:hover {
    color: var(--color-rose-strong);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary svg {
    width: 1.25rem;
    flex: none;
    fill: none;
    stroke: var(--color-rose-strong);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s var(--ease-out);
  }

  details[open] summary svg {
    transform: rotate(180deg);
  }

  details p {
    max-width: 40rem;
    margin: 0;
    padding-bottom: var(--space-6);
    color: var(--color-text-muted);
  }

  @media (width >= 64rem) {
    .faq {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--space-16);
      align-items: start;
    }
  }
</style>
